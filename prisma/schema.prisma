generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== PENGGUNA ==========
model Pengguna {
  id       String @id @default(cuid())
  name     String @db.VarChar(100)
  email    String @unique @db.VarChar(100)
  password String @db.VarChar(255)
  role     String @default("TATA_USAHA") @db.VarChar(50) // ADMIN, TATA_USAHA, KEPALA_SEKOLAH

  unitSekolahId String? // Null berarti akses global ke semua unit
  divisiId      String? // Relasi ke tabel Divisi

  avatar    String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitSekolah UnitSekolah? @relation(fields: [unitSekolahId], references: [id])
  divisi      Divisi?      @relation(fields: [divisiId], references: [id])

  transaksiKas     TransaksiKas[]
  pembayaran       Pembayaran[]
  urutanPengesahan UrutanPengesahan[]
  logAktivitas     LogAktivitas[]
}

// ========== DIVISI ==========
model Divisi {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  description String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pengguna     Pengguna[]
  transaksiKas TransaksiKas[]
}

// ========== UNIT SEKOLAH ==========
model UnitSekolah {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100) // "SD Al Basyariah", "SMP Al Basyariah", "SMK Al Basyariah"
  level     String   @db.VarChar(50) // "SD", "SMP", "SMK", "MA", dll
  address   String?  @db.Text
  phone     String?  @db.VarChar(20)
  logo      String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tingkat           Tingkat[]
  jurusan           Jurusan[]
  subKelas          SubKelas[]
  murid             Murid[]
  klasifikasiAkun   KlasifikasiAkun[]
  akunPenting       AkunPenting[]
  urutanPengesahan  UrutanPengesahan[]
  transaksiKas      TransaksiKas[]
  pengguna          Pengguna[]
  jenisTagihan      JenisTagihan[]
  anggaran          Anggaran[]
  penjualanFormulir PenjualanFormulir[]
}

// ========== TAHUN AKADEMIK ==========
model TahunAkademik {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50) // "2025/2026"
  isActive  Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  subKelas          SubKelas[]
  jenisTagihan      JenisTagihan[]
  anggaran          Anggaran[]
  penjualanFormulir PenjualanFormulir[]
  riwayatKelas      RiwayatKelas[]
}

// ========== KELAS & MURID ==========
model Tingkat {
  id            String  @id @default(cuid())
  name          String  @db.VarChar(50) // "X", "XI", "XII"
  order         Int // untuk sorting
  isDeleted     Boolean @default(false)
  unitSekolahId String

  unitSekolah UnitSekolah @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  subKelas    SubKelas[]
}

model Jurusan {
  id            String  @id @default(cuid())
  name          String  @db.VarChar(100) // "TKJ", "RPL", "OTKP"
  code          String  @db.VarChar(20)
  isDeleted     Boolean @default(false)
  unitSekolahId String

  unitSekolah UnitSekolah @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  subKelas    SubKelas[]

  @@unique([code, unitSekolahId]) // Kode jurusan harus unik dalam satu unit sekolah
}

model SubKelas {
  id              String  @id @default(cuid())
  name            String  @db.VarChar(100) // "X TKJ 1"
  tingkatId       String
  jurusanId       String?
  tahunAkademikId String
  isDeleted       Boolean @default(false)
  unitSekolahId   String

  unitSekolah   UnitSekolah    @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  tingkat       Tingkat        @relation(fields: [tingkatId], references: [id], onDelete: Cascade)
  jurusan       Jurusan?       @relation(fields: [jurusanId], references: [id])
  tahunAkademik TahunAkademik  @relation(fields: [tahunAkademikId], references: [id], onDelete: Cascade)
  riwayatKelas  RiwayatKelas[]
}

model Murid {
  id            String  @id @default(cuid())
  nis           String  @unique @db.VarChar(50)
  name          String  @db.VarChar(150)
  unitSekolahId String
  isActive      Boolean @default(true)
  isDeleted     Boolean @default(false)
  isScholarship Boolean @default(false)

  // Field pendaftaran
  // Identitas Pribadi
  nisn           String?   @db.VarChar(50)
  nickname       String?   @db.VarChar(50)
  nik            String?   @db.VarChar(16)
  birthPlace     String?   @db.VarChar(100)
  birthDate      DateTime?
  gender         String?   @db.VarChar(20)
  religion       String?   @db.VarChar(50)
  childOrder     Int?
  siblingCount   Int?

  // Pendidikan & Periodik
  previousSchool   String?   @db.VarChar(150)
  height           Float?
  weight           Float?
  headSize         Float?
  distanceToSchool String?   @db.VarChar(50)
  travelTime       String?   @db.VarChar(50)

  // Data Ayah
  fatherName       String?   @db.VarChar(150)
  fatherBirthYear  String?   @db.VarChar(4)
  fatherNik        String?   @db.VarChar(16)
  fatherEducation  String?   @db.VarChar(50)
  fatherOccupation String?   @db.VarChar(100)
  fatherIncome     String?   @db.VarChar(50)

  // Data Ibu
  motherName       String?   @db.VarChar(150)
  motherBirthYear  String?   @db.VarChar(4)
  motherNik        String?   @db.VarChar(16)
  motherEducation  String?   @db.VarChar(50)
  motherOccupation String?   @db.VarChar(100)
  motherIncome     String?   @db.VarChar(50)

  // Data Wali
  guardianName       String?   @db.VarChar(150)
  guardianBirthYear  String?   @db.VarChar(4)
  guardianNik        String?   @db.VarChar(16)
  guardianEducation  String?   @db.VarChar(50)
  guardianOccupation String?   @db.VarChar(100)
  guardianIncome     String?   @db.VarChar(50)
  guardianPhone      String?   @db.VarChar(20)

  // Kontak & Alamat
  phone          String?   @db.VarChar(20)
  parentPhone    String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  address        String?   @db.Text
  rt             String?   @db.VarChar(5)
  rw             String?   @db.VarChar(5)
  village        String?   @db.VarChar(100) // Kelurahan
  district       String?   @db.VarChar(100) // Kecamatan
  postalCode     String?   @db.VarChar(10)

  // Kesehatan
  bloodType      String?   @db.VarChar(5)
  medicalHistory String?   @db.Text

  // Lain-lain
  status         String    @default("AKTIF") @db.VarChar(50)
  password       String?   @db.VarChar(255)
  photoUrl       String?   @db.VarChar(255)
  formNo         String?   @db.VarChar(50)
  username       String?   @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitSekolah  UnitSekolah    @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  riwayatKelas RiwayatKelas[]
  tagihan      Tagihan[]
}

model RiwayatKelas {
  id              String   @id @default(cuid())
  muridId         String
  subKelasId      String
  tahunAkademikId String
  createdAt       DateTime @default(now())

  murid         Murid         @relation(fields: [muridId], references: [id], onDelete: Cascade)
  subKelas      SubKelas      @relation(fields: [subKelasId], references: [id], onDelete: Cascade)
  tahunAkademik TahunAkademik @relation(fields: [tahunAkademikId], references: [id], onDelete: Cascade)

  @@unique([muridId, tahunAkademikId])
}

// ========== AKUN KEUANGAN ==========
model KlasifikasiAkun {
  id            String @id @default(cuid())
  code          String @default("0") @db.VarChar(10) // "1"=HARTA, "2"=KEWAJIBAN, "3"=MODAL, "4"=PENDAPATAN, "5"=BEBAN
  name          String @db.VarChar(100) // "HARTA", "PENDAPATAN"
  unitSekolahId String

  unitSekolah        UnitSekolah          @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  subKlasifikasiAkun SubKlasifikasiAkun[]
}

model SubKlasifikasiAkun {
  id                String @id @default(cuid())
  code              String @unique @db.VarChar(50) // "10000001"
  name              String @db.VarChar(100) // "KAS & BANK"
  klasifikasiAkunId String

  klasifikasiAkun KlasifikasiAkun @relation(fields: [klasifikasiAkunId], references: [id], onDelete: Cascade)
  akunDetail      AkunDetail[]
}

model AkunDetail {
  id                   String  @id @default(cuid())
  code                 String  @unique @db.VarChar(50)
  name                 String  @db.VarChar(150)
  subKlasifikasiAkunId String
  isActive             Boolean @default(true)
  bankAccountNumber    String? @db.VarChar(100)

  subKlasifikasiAkun SubKlasifikasiAkun @relation(fields: [subKlasifikasiAkunId], references: [id], onDelete: Cascade)
  transaksiKas       TransaksiKas[]
  itemTransaksiKas   ItemTransaksiKas[]
  anggaranDetails    ItemAnggaran[]
}

model AkunPenting {
  id            String  @id @default(cuid())
  name          String  @db.VarChar(100) // "Laba Ditahan"
  description   String  @db.Text
  akunDetailId  String? // akun yang dipilih
  unitSekolahId String

  unitSekolah UnitSekolah @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
}

// ========== URUTAN PENGESAHAN ==========
model UrutanPengesahan {
  id            String  @id @default(cuid())
  penggunaId    String
  unitSekolahId String
  name          String  @db.VarChar(100)
  order         Int
  status        Boolean @default(true)

  pengguna    Pengguna    @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  unitSekolah UnitSekolah @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
}

// ========== TRANSAKSI KAS ==========
model TransaksiKas {
  id            String   @id @default(cuid())
  type          String   @db.VarChar(20) // IN, OUT
  referenceNo   String   @unique @db.VarChar(100) // auto-generate
  formNo        String?  @db.VarChar(50)
  akunDetailId  String
  unitSekolahId String
  studentName   String?  @db.VarChar(150)
  classroomName String?  @db.VarChar(100)
  description   String?  @db.Text
  totalAmount   Decimal  @db.Decimal(15, 2)
  date          DateTime
  status        String   @default("DRAFT") @db.VarChar(30) // DRAFT, APPROVED, REJECTED
  bookkeeping   String?  @db.VarChar(100)
  recipientName String?  @db.VarChar(150)
  isDeleted     Boolean  @default(false)
  isEdited      Boolean  @default(false)
  editReason    String?  @db.Text
  createdById   String
  divisiId      String? // Relasi opsional ke divisi untuk cost center
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unitSekolah UnitSekolah @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  akunDetail  AkunDetail  @relation(fields: [akunDetailId], references: [id], onDelete: Cascade)
  createdBy   Pengguna    @relation(fields: [createdById], references: [id])
  divisi      Divisi?     @relation(fields: [divisiId], references: [id])

  items ItemTransaksiKas[]
}

// ========== ITEM TRANSAKSI KAS (MULTI-BARIS) ==========
model ItemTransaksiKas {
  id             String  @id @default(cuid())
  transaksiKasId String
  akunDetailId   String
  amount         Decimal @db.Decimal(15, 2)
  description    String? @db.Text

  transaksiKas TransaksiKas @relation(fields: [transaksiKasId], references: [id], onDelete: Cascade)
  akunDetail   AkunDetail   @relation(fields: [akunDetailId], references: [id], onDelete: Cascade)
}

// ========== TAGIHAN & PEMBAYARAN ==========
model JenisTagihan {
  id              String  @id @default(cuid())
  name            String  @db.VarChar(150) // "SPP", "Ujian"
  amount          Decimal @db.Decimal(15, 2)
  tahunAkademikId String
  unitSekolahId   String

  unitSekolah   UnitSekolah   @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  tahunAkademik TahunAkademik @relation(fields: [tahunAkademikId], references: [id], onDelete: Cascade)
  tagihan       Tagihan[]
}

model Tagihan {
  id             String    @id @default(cuid())
  jenisTagihanId String
  muridId        String
  amount         Decimal   @db.Decimal(15, 2)
  dueDate        DateTime?
  status         String    @default("UNPAID") @db.VarChar(30) // UNPAID, PARTIAL, PAID
  createdAt      DateTime  @default(now())

  jenisTagihan JenisTagihan @relation(fields: [jenisTagihanId], references: [id], onDelete: Cascade)
  murid        Murid        @relation(fields: [muridId], references: [id], onDelete: Cascade)
  pembayaran   Pembayaran[]
}

model Pembayaran {
  id          String   @id @default(cuid())
  tagihanId   String
  amount      Decimal  @db.Decimal(15, 2)
  paymentDate DateTime
  method      String   @db.VarChar(50) // TUNAI, TRANSFER
  methodOther String?  @db.VarChar(100)
  vaNumber    String?  @db.VarChar(50)
  receiptNo   String?  @db.VarChar(100)
  createdById String
  createdAt   DateTime @default(now())

  tagihan   Tagihan  @relation(fields: [tagihanId], references: [id], onDelete: Cascade)
  createdBy Pengguna @relation(fields: [createdById], references: [id])
}

// ========== ANGGARAN ==========
model Anggaran {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(150)
  tahunAkademikId String
  unitSekolahId   String
  totalAmount     Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  unitSekolah   UnitSekolah    @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  tahunAkademik TahunAkademik  @relation(fields: [tahunAkademikId], references: [id], onDelete: Cascade)
  itemAnggaran  ItemAnggaran[]
}

model ItemAnggaran {
  id           String  @id @default(cuid())
  anggaranId   String
  akunDetailId String
  amount       Decimal @db.Decimal(15, 2)
  realized     Decimal @default(0) @db.Decimal(15, 2)

  anggaran   Anggaran   @relation(fields: [anggaranId], references: [id], onDelete: Cascade)
  akunDetail AkunDetail @relation(fields: [akunDetailId], references: [id], onDelete: Cascade)
}

// ========== FORMULIR PSB ==========
model PenjualanFormulir {
  id              String   @id @default(cuid())
  buyerName       String   @db.VarChar(150)
  amount          Decimal  @db.Decimal(15, 2)
  saleDate        DateTime
  tahunAkademikId String
  unitSekolahId   String
  createdAt       DateTime @default(now())

  unitSekolah   UnitSekolah   @relation(fields: [unitSekolahId], references: [id], onDelete: Cascade)
  tahunAkademik TahunAkademik @relation(fields: [tahunAkademikId], references: [id], onDelete: Cascade)
}

// ========== LOG AKTIVITAS (AUDIT TRAIL) ==========
model LogAktivitas {
  id         String   @id @default(cuid())
  penggunaId String
  aksi       String   @db.VarChar(100) // contoh: "TAMBAH_USER", "HAPUS_DIVISI"
  modul      String   @db.VarChar(50) // contoh: "PENGATURAN", "KAS"
  keterangan String   @db.Text
  createdAt  DateTime @default(now())

  pengguna Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
}
