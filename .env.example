# ==========================================
# SIRAYA PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Database Postgres (Internal Docker Network)
POSTGRES_USER=siraya_admin
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=siraya_albasyariah

# NextAuth Secret (Generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
AUTH_TRUST_HOST=true

# Alamat Aplikasi
APP_URL=https://siraya.my.id
